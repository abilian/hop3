# hop3.toml - Simple Application Example
# Minimal configuration demonstrating "Convention over Configuration"

[metadata]
id = "my-app"
version = "1.0.0"

[run]
# Just specify how to start your application
start = "python app.py"

# That's it! This is all you need for a basic app.
# Hop3 will handle the rest with sensible defaults.

# Optional: Add a pre-run command if needed
# before-run = "python setup.py"
