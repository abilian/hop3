# hop3.toml - Python/Django Application Example
# This file demonstrates a complete hop3.toml configuration for a Django application

[metadata]
id = "my-django-app"
version = "1.0.0"
title = "My Django Application"
author = "Your Name <you@example.com>"

[build]
# Commands to run during build phase
before-build = [
    "pip install -r requirements.txt",
    "python manage.py collectstatic --noinput"
]

# Optional: Run tests during build
test = "python manage.py test"

# Optional: System packages needed for build
packages = ["postgresql-dev", "gcc", "python3-dev"]

[run]
# Main application start command
start = "gunicorn myapp.wsgi:application --workers 4 --bind 0.0.0.0:8000"

# Commands to run before starting the application
before-run = [
    "python manage.py migrate --noinput",
    "python manage.py createcachetable"
]

# System packages needed at runtime
packages = ["postgresql", "redis"]

[env]
# Environment variables (sensitive values should come from actual env)
DJANGO_SETTINGS_MODULE = "myapp.settings.production"
DEBUG = "false"
ALLOWED_HOSTS = "myapp.example.com"

[port]
web = 8000

[healthcheck]
path = "/health/"
timeout = 30
interval = 60

[backup]
enabled = true
schedule = "0 2 * * *"  # Daily at 2 AM
retention = 7  # Keep 7 days of backups

[[provider]]
name = "postgres"
plan = "standard"

[[provider]]
name = "redis"
plan = "basic"
