# Radicale Configuration Template
# This file is used as reference; actual config is generated by start.sh

[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /app/data/htpasswd
htpasswd_encryption = bcrypt

[rights]
type = from_file
file = /app/rights

[storage]
type = multifilesystem
filesystem_folder = /app/data/collections

[web]
type = internal

[logging]
level = warning
