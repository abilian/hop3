listen:
  hostname: '127.0.0.1'
  port: 9000

webserver:
  https: true
  hostname: 'localhost'
  port: 443

rates_limit:
  api:
    window: 10 seconds
    max: 50
  login:
    window: 5 minutes
    max: 15
  signup:
    window: 5 minutes
    max: 2
  ask_send_email:
    window: 5 minutes
    max: 3
  receive_client_log:
    window: 10 seconds
    max: 10

trust_proxy:
  - '127.0.0.1'

database:
  hostname: 'localhost'
  port: 5432
  ssl: false
  username: 'peertube'
  password: ''
  name: 'peertube'

redis:
  hostname: 'localhost'
  port: 6379
  auth: ''

smtp:
  hostname: 'localhost'
  port: 25
  username: ''
  password: ''
  tls: false
  disable_starttls: true
  ca_file: null
  from_address: 'noreply@localhost'

email:
  body:
    signature: 'PeerTube'

storage:
  tmp: '/app/data/storage/tmp/'
  bin: '/app/data/storage/bin/'
  avatars: '/app/data/storage/avatars/'
  web_videos: '/app/data/storage/web-videos/'
  streaming_playlists: '/app/data/storage/streaming-playlists/'
  redundancy: '/app/data/storage/redundancy/'
  logs: '/app/data/storage/logs/'
  previews: '/app/data/storage/previews/'
  thumbnails: '/app/data/storage/thumbnails/'
  storyboards: '/app/data/storage/storyboards/'
  torrents: '/app/data/storage/torrents/'
  captions: '/app/data/storage/captions/'
  cache: '/run/peertube/cache/'
  plugins: '/app/data/storage/plugins/'
  well_known: '/app/data/storage/well-known/'
  tmp_persistent: '/app/data/storage/tmp_persistent/'
  client_overrides: '/app/data/storage/client-overrides/'
  original_video_files: '/app/data/storage/original_video_files/'

object_storage:
  enabled: false

log:
  level: 'info'
  rotation:
    enabled: true

static_files:
  private_files_require_auth: true

trending:
  videos:
    interval_days: 7

redundancy:
  videos:
    check_interval: '1 hour'
    strategies: []

csp:
  enabled: false
  report_only: true
  report_uri: ''

tracker:
  enabled: true
  private: false
  reject_too_many_announces: false

history:
  videos:
    max_age: -1

import:
  videos:
    http:
      enabled: true
    torrent:
      enabled: true

auto_blacklist:
  videos:
    of_users:
      enabled: false

cache:
  previews:
    size: 500
  captions:
    size: 500
  torrents:
    size: 500
  storyboards:
    size: 500

admin:
  email: 'admin@localhost'

contact_form:
  enabled: true

signup:
  enabled: false
  limit: 10
  minimum_age: 16

user:
  history:
    videos:
      enabled: true
  video_quota: -1
  video_quota_daily: -1

video_channels:
  max_per_user: 20

transcoding:
  enabled: true
  original_file:
    keep: true
  allow_additional_extensions: true
  allow_audio_files: true
  threads: 0
  concurrency: 1
  profile: 'default'
  resolutions:
    0p: false
    144p: false
    240p: false
    360p: false
    480p: true
    720p: true
    1080p: true
    1440p: true
    2160p: true
  web_videos:
    enabled: true
  hls:
    enabled: true
  remote_runners:
    enabled: false

live:
  enabled: false
  allow_replay: true
  latency_setting:
    enabled: true
  rtmp:
    enabled: true
    port: 1935
    hostname: ''
  rtmps:
    enabled: false
  transcoding:
    enabled: true
    threads: 0
    profile: 'default'
    resolutions:
      144p: false
      240p: false
      360p: false
      480p: true
      720p: true
      1080p: true
      1440p: true
      2160p: true
    remote_runners:
      enabled: false

video_studio:
  enabled: false

video_file:
  update:
    enabled: false

instance:
  name: 'PeerTube'
  short_description: ''
  description: ''
  terms: ''
  code_of_conduct: ''
  moderation_information: ''
  creation_reason: ''
  administrator: ''
  maintenance_lifetime: ''
  business_model: ''
  hardware_information: ''
  languages: []
  categories: []
  default_client_route: '/videos/trending'
  is_nsfw: false
  default_nsfw_policy: 'do_not_list'

services:
  twitter:
    username: '@Chocobozzz'

followers:
  instance:
    enabled: true
    manual_approval: false

followings:
  instance:
    auto_follow_back:
      enabled: false
    auto_follow_index:
      enabled: false

theme:
  default: 'default'

broadcast_message:
  enabled: false
  message: ''
  level: 'info'
  dismissable: false

search:
  remote_uri:
    users: true
    anonymous: false
  search_index:
    enabled: false

federation:
  videos:
    federate_unlisted: false
    cleanup_remote_interactions: true
