# Dockerfile for hop3 system testing
# This installs OS packages in cacheable layers.
#
# Docker automatically caches unchanged layers, so rebuilds are fast
# unless package lists change.
#
# Build: docker build -f Dockerfile.base -t hop3-test:latest .
# Run:   docker run -d --name hop3-test hop3-test:latest
#
# After hop3 installation, the container can be switched to supervisor mode
# to manage services (nginx, uwsgi, hop3-server) like a real server.

FROM ubuntu:24.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Layer 1: Update apt cache (invalidated if base image changes)
RUN apt-get update -q

# Layer 2: Essential tools (rarely changes)
RUN apt-get install -q -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-dev \
    git \
    curl \
    sudo \
    ca-certificates

# Layer 3: Build tools (rarely changes)
RUN apt-get install -q -y --no-install-recommends \
    build-essential \
    libffi-dev \
    libssl-dev

# Layer 4: Network/SSH tools (rarely changes)
RUN apt-get install -q -y --no-install-recommends \
    openssh-server \
    openssh-client \
    gnupg

# Layer 5: Web and database servers (may change with new features)
RUN apt-get install -q -y --no-install-recommends \
    nginx \
    postgresql

# Layers 5b and 5c: what the installer itself installs on Ubuntu 24.04, so a
# fresh container does not download it again (13 of a 17.5-minute deploy). The
# installer's apt calls still run and find it installed. The lists are derived
# from the installer's code; tests/a_unit/test_docker_image_packages.py fails
# when they drift, and the image must hold nothing the installer does not.
COPY packages/hop3-installer/docker/noble-packages.txt /tmp/
RUN apt-get update -q \
    && xargs -a /tmp/noble-packages.txt apt-get install -q -y --no-install-recommends

# Go and the .NET SDKs, installed with their recommends as the installer does.
COPY packages/hop3-installer/docker/noble-packages-with-recommends.txt /tmp/
RUN xargs -a /tmp/noble-packages-with-recommends.txt apt-get install -q -y

# Layer 6: Process management and utilities
RUN apt-get install -q -y --no-install-recommends \
    supervisor \
    procps \
    net-tools \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Layer 7: Setup SSH
RUN mkdir -p /run/sshd

# Note: hop3 user creation is handled by hop3-install server
# The installer creates the user with proper UID/GID for the target system

# Layer 8: Pre-create directories for services
RUN mkdir -p /var/log/uwsgi /var/log/supervisor

# Copy entrypoint script that handles both modes:
# - "sleep" mode: for installer testing (default)
# - "supervisor" mode: for running services after installation
# Note: Path is relative to build context (project root)
COPY packages/hop3-installer/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Default to sleep mode for backwards compatibility
ENV HOP3_DOCKER_MODE=sleep

CMD ["/entrypoint.sh"]
