[2.006, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying Docker + MySQL Application                              |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo28/\u001b[0m\r\n  |-- \u001b[32mapp.py\u001b[0m - Flask application with MySQL page counter\r\n  |-- \u001b[32mrequirements.txt\u001b[0m - Python dependencies (flask, mysql-connector-python)\r\n  |-- \u001b[32mDockerfile\u001b[0m - Container image definition\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration (builder=docker)\r\n\r\n  \u001b[2mThis demo validates the MySQL addon with a simple page view counter.\u001b[0m\r\n\r\n"]
[2.001, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m# hop3.toml - Docker app with MySQL addon\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[metadata]\u001b[0m\r\n  \u001b[2mid = \"demo28-mysql-counter\"\u001b[0m\r\n  \u001b[2mversion = \"0.1.0\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mtitle = \"MySQL Page Counter Demo\"\u001b[0m\r\n  \u001b[2mdescription = \"Demonstrates Docker deployment with MySQL addon - simple page view counter\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[build]\u001b[0m\r\n  \u001b[2mbuilder = \"docker\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n\r\n"]
