[1.566, "o", "Addon 'demo29-db' of type 'mysql' created successfully.\r\n\r\nTo attach this service to an app, run:\r\n  hop3 addon attach demo29-db --app <app>\r\n\r\n\u001b[32m[OK]\u001b[0m MySQL database 'demo29-db' created.\r\n"]
