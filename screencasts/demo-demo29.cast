[3.233, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Running: Demo 29: Native Python + MySQL (Page Counter)            |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[2m\r\nDemonstrates native Python deployment with MySQL addon:\r\n  - Building and deploying a native Python application\r\n  - Creating a MySQL database via addon\r\n  - Connecting the app to MySQL\r\n  - Testing database operations with a page counter\r\n\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[33m->\u001b[0m Checking if MySQL is installed...\r\n"]
[0.733, "o", "\u001b[32m[OK]\u001b[0m MySQL is installed\r\n\u001b[33m->\u001b[0m Checking MySQL service status...\r\n"]
[0.792, "o", "\u001b[32m[OK]\u001b[0m MySQL service is running\r\n\u001b[33m->\u001b[0m Verifying MySQL password authentication...\r\n"]
[0.734, "o", "\u001b[32m[OK]\u001b[0m MySQL password authentication configured\r\n"]
[2.004, "o", "\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying Native Python + MySQL Application                       |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[0.001, "o", "\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo29/\u001b[0m\r\n  |-- \u001b[32mapp.py\u001b[0m - Flask application with MySQL page counter\r\n  |-- \u001b[32mrequirements.txt\u001b[0m - Python dependencies (flask, mysql-connector-python)\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration (native Python builder)\r\n\r\n  \u001b[2mThis demo validates the MySQL addon with a native Python app.\u001b[0m\r\n  \u001b[2mUnlike demo28, this does NOT use Docker - it runs directly on the server.\u001b[0m\r\n\r\n"]
[2.003, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m# hop3.toml - Native Python app with MySQL addon\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[metadata]\u001b[0m\r\n  \u001b[2mid = \"demo29-mysql-counter\"\u001b[0m\r\n  \u001b[2mversion = \"0.1.0\"\u001b[0m\r\n  \u001b[2mtitle = \"Native MySQL Page Counter Demo\"\u001b[0m\r\n  \u001b[2mdescription = \"Demonstrates native Python deployment with MySQL addon - simple page view counter\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m[build]\u001b[0m\r\n  \u001b[2m# Use native builder - Python toolchain is auto-detected from requirements.txt\u001b[0m\r\n  \u001b[2mbuilder = \"local\"\u001b[0m\r\n  \u001b[2mpip-install = [\"-r\", \"requirements.txt\"]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n  \u001b[2m[run]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mstart = \"gunicorn --workers 2 --bind 0.0.0.0:$PORT app:app\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n\r\n"]
[2.006, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Step 1: Deploy Native Python Application                          |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[6.985, "o", "\u001b[33m->\u001b[0m Deploying demo29 application...\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  \u001b[2m$\u001b[0m \u001b[1mhop3 deploy --app demo29 --force\u001b[0m\r\n\r\n"]
