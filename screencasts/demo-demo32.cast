[2.403, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m|  Running: Demo 32: Native Python + Redis                           |\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[2m\r\nDemonstrates native Python deployment with Redis addon:\r\n  - Building and deploying a native Python application\r\n  - Creating a Redis instance via addon\r\n  - Connecting the app to Redis\r\n  - Testing counter and caching operations\r\n\u001b[0m"]
[0.000, "o", "\r\n\r\n"]
[0.000, "o", "\u001b[33m->\u001b[0m Checking if Redis is installed...\r\n"]
[0.753, "o", "\u001b[32m[OK]\u001b[0m Redis is installed\r\n\u001b[33m->\u001b[0m Checking Redis service status...\r\n"]
[0.736, "o", "\u001b[32m[OK]\u001b[0m Redis service is running\r\n\u001b[33m->\u001b[0m Verifying Redis is responding...\r\n"]
[0.746, "o", "\u001b[32m[OK]\u001b[0m Redis is responding\r\n"]
[3.959, "o", "Addon 'demo32-cache' of type 'redis' destroyed successfully.\r\n\r\n\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying Native Python + Redis Application                       |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo32/\u001b[0m\r\n  |-- \u001b[32mapp.py\u001b[0m - Flask application with Redis support\r\n  |-- \u001b[32mrequirements.txt\u001b[0m - Python dependencies (flask, redis)\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration (native Python builder)\r\n\r\n  \u001b[2mThis demo shows a native Python app connecting to a Redis addon.\u001b[0m\r\n  \u001b[2mUnlike demo16, this does NOT use Docker.\u001b[0m\r\n\r\n"]
[2.006, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.002, "o", "  \u001b[2m# hop3.toml - Native Python app with Redis addon\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[metadata]\u001b[0m\r\n  \u001b[2mid = \"demo32-redis\"\u001b[0m\r\n  \u001b[2mversion = \"0.1.0\"\u001b[0m\r\n  \u001b[2mtitle = \"Native Redis Demo\"\u001b[0m\r\n  \u001b[2mdescription = \"Demonstrates native Python deployment with Redis addon\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[build]\u001b[0m\r\n  \u001b[2m# Use native builder - Python toolchain is auto-detected from requirements.txt\u001b[0m\r\n  \u001b[2mbuilder = \"local\"\u001b[0m\r\n  \u001b[2mpip-install = [\"-r\", \"requirements.txt\"]\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[run]\u001b[0m\r\n  \u001b[2mstart = \"gunicorn --workers 2 --bind 0.0.0.0:$PORT app:app\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n\r\n"]
[2.006, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Step 1: Deploy Native Python Application                          |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
