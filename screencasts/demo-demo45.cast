[4.175, "o", "Addon 'demo45-db' of type 'postgres' does not exist.\r\n\r\n\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying Ruby/Sinatra + PostgreSQL                               |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo45/\u001b[0m\r\n  |-- \u001b[32mDockerfile\u001b[0m - Docker image based on ruby:3.2-alpine\r\n  |-- \u001b[32mapp.rb\u001b[0m - Sinatra app with PostgreSQL connection\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration with [[provider]] section\r\n\r\n  \u001b[2mThis is a minimal test to verify Ruby + PostgreSQL works.\u001b[0m\r\n\r\n"]
[2.005, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  \u001b[2m# Demo 45: Minimal Ruby/Sinatra with PostgreSQL\u001b[0m\r\n  \u001b[2m# Tests Ruby + PostgreSQL connectivity\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[metadata]\u001b[0m\r\n  \u001b[2mid = \"ruby-postgres\"\u001b[0m\r\n  \u001b[2mversion = \"1.0\"\u001b[0m\r\n  \u001b[2mtitle = \"Ruby/Sinatra + PostgreSQL\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mdescription = \"Minimal Ruby app testing PostgreSQL connectivity\"\u001b[0m\r\n  \u001b[2mtags = [\"ruby\", \"sinatra\", \"postgres\"]\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[build]\u001b[0m\r\n  \u001b[2mbuilder = \"docker\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[docker]\u001b[0m\r\n  \u001b[2mport = 4567\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[[addons]]\u001b[0m\r\n  \u001b[2mtype = \"postgres\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n\r\n"]
[2.005, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m|  Step 1: Create PostgreSQL Database                                |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[33m->\u001b[0m Creating PostgreSQL instance 'demo45-db'...\r\n"]
[0.000, "o", "\r\n  \u001b[2m$\u001b[0m \u001b[1mhop3 addon create postgres demo45-db\u001b[0m\r\n\r\n"]
[1.228, "o", "Addon 'demo45-db' of type 'postgres' created successfully.\r\n\r\nTo attach this service to an app, run:\r\n  hop3 addon attach demo45-db --app <app>\r\n\r\n"]
