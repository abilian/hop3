[2.006, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying Docker Go Application                                   |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo19/\u001b[0m\r\n"]
[0.000, "o", "  |-- \u001b[32mmain.go\u001b[0m - Go application with Gin\r\n  |-- \u001b[32mgo.mod\u001b[0m - Go module definition\r\n"]
[0.000, "o", "  |-- \u001b[32mDockerfile\u001b[0m - Multi-stage build\r\n"]
[0.000, "o", "  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  \u001b[2mThis demo uses a multi-stage Docker build for a minimal image.\u001b[0m\r\n\r\n"]
[2.002, "o", "\u001b[33m->\u001b[0m Dockerfile (multi-stage build):\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m# Demo 19: Docker Go application\u001b[0m\r\n  \u001b[2m# Multi-stage build for smaller image\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m# Build stage\u001b[0m\r\n  \u001b[2mFROM golang:1.22-alpine AS builder\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n  \u001b[2mWORKDIR /app\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m# Copy go mod files\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mCOPY go.mod go.sum ./\u001b[0m\r\n  \u001b[2mRUN go mod download\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m# Copy source code\u001b[0m\r\n  \u001b[2mCOPY . .\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m# Build the binary\u001b[0m\r\n  \u001b[2mRUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main .\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m# Runtime stage\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mFROM alpine:latest\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mWORKDIR /app\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m# Copy binary from builder\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mCOPY --from=builder /app/main .\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m# Expose port\u001b[0m\r\n  \u001b[2mEXPOSE 8080\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m# Run the application\u001b[0m\r\n  \u001b[2mCMD [\"./main\"]\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n\r\n"]
[0.000, "o", "  \u001b[2mStage 1: Build Go binary with full toolchain\u001b[0m\r\n  \u001b[2mStage 2: Copy binary to minimal Alpine image\u001b[0m\r\n\r\n"]
[2.005, "o", "\u001b[33m->\u001b[0m Application code (main.go):\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m// Copyright (c) 2025, Abilian SAS\u001b[0m\r\n  \u001b[2m// SPDX-License-Identifier: Apache-2.0\u001b[0m\r\n  \u001b[2m//\u001b[0m\r\n  \u001b[2m// Demo 19: Docker Go application using Gin framework\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2mpackage main\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mimport (\u001b[0m\r\n  \u001b[2m\t\"net/http\"\u001b[0m\r\n  \u001b[2m\t\"os\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t\"runtime\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t\"strconv\"\u001b[0m\r\n  \u001b[2m\t\"time\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m\t\"github.com/gin-gonic/gin\"\u001b[0m\r\n  \u001b[2m)\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mvar (\u001b[0m\r\n  \u001b[2m\tstartTime    = time.Now()\u001b[0m\r\n  \u001b[2m\trequestCount int64\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m)\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2mfunc main() {\u001b[0m\r\n  \u001b[2m\t// Set gin mode\u001b[0m\r\n  \u001b[2m\tif os.Getenv(\"GIN_MODE\") == \"\" {\u001b[0m\r\n  \u001b[2m\t\tgin.SetMode(gin.ReleaseMode)\u001b[0m\r\n  \u001b[2m\t}\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m\tr := gin.Default()\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m\t// Home endpoint\u001b[0m\r\n  \u001b[2m\tr.GET(\"/\", func(c *gin.Context) {\u001b[0m\r\n  \u001b[2m\t\tc.JSON(http.StatusOK, gin.H{\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t\t\t\"app\":     \"demo19\",\u001b[0m\r\n  \u001b[2m\t\t\t\"type\":    \"docker-go\",\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t\t\t\"message\": \"Welcome to demo19 - Docker Go/Gin!\",\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t\t\t\"runtime\": runtime.Version(),\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t\t})\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\t})\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n  \u001b[2m\t// Info endpoint\u001b[0m\r\n  \u001b[2m\tr.GET(\"/info\", func(c *gin.Context) {\u001b[0m\r\n  \u001b[2m\t\tc.JSON(http.StatusOK, gin.H{\u001b[0m\r\n  \u001b[2m\t\t\t\"go_version\": runtime.Version(),\u001b[0m\r\n  \u001b[2m\t\t\t\"os\":         runtime.GOOS,\u001b[0m\r\n  \u001b[2m\t\t\t\"arch\":       runtime.GOARCH,\u001b[0m\r\n  \u001b[2m\t\t\t\"cpus\":       runtime.NumCPU(),\u001b[0m\r\n  \u001b[2m\t\t\t\"goroutines\": runtime.NumGoroutine(),\u001b[0m\r\n  \u001b[2m\t\t})\u001b[0m\r\n  \u001b[2m\t})\u001b[0m\r\n\r\n"]
[2.002, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m|  Step 1: Deploy Application                                        |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n  \u001b[2mBuilding Docker image (multi-stage)...\u001b[0m\r\n"]
