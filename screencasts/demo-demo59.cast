[3.229, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Running: Demo 59: Elixir Prerequisite Test                        |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[2m\r\nTests Elixir runtime prerequisites:\r\n  - Elixir interpreter\r\n  - Mix build tool\r\n  - Plug web framework\r\n  - Cowboy HTTP server\r\n\u001b[0m\r\n\r\n"]
[0.000, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Testing Elixir Prerequisites                                      |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo59/\u001b[0m\r\n  |-- \u001b[32mlib/demo59.ex\u001b[0m - Plug application\r\n  |-- \u001b[32mmix.exs\u001b[0m - Elixir dependencies\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration\r\n\r\n  \u001b[2mThis demo verifies Elixir runtime prerequisites for Phoenix deployments.\u001b[0m\r\n"]
[2.008, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m[metadata]\u001b[0m\r\n  \u001b[2mid = \"demo59\"\u001b[0m\r\n  \u001b[2mversion = \"1.0.0\"\u001b[0m\r\n  \u001b[2mtitle = \"Elixir Prerequisite Test\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[build]\u001b[0m\r\n  \u001b[2m# Clean all build artifacts before rebuilding to avoid stale state\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m# MIX_HOME and HEX_HOME are in parent directory (..), deps/_build are in current directory\u001b[0m\r\n  \u001b[2mbefore-build = [\"rm -rf _build deps ../.mix ../.hex\", \"mix local.hex --force\", \"mix local.rebar --force\", \"mix deps.clean --all\", \"mix deps.get\", \"mix compile\"]\u001b[0m\r\n  \u001b[2mpackages = [\"elixir\", \"erlang\"]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n  \u001b[2m[run]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mstart = \"elixir --no-halt -S mix run\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m[env]\u001b[0m\r\n  \u001b[2mMIX_ENV = \"prod\"\u001b[0m\r\n  \u001b[2mMIX_HOME = \"/home/hop3/apps/demo59/.mix\"\u001b[0m\r\n  \u001b[2mHEX_HOME = \"/home/hop3/apps/demo59/.hex\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[port]\u001b[0m\r\n  \u001b[2mweb = 4000\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[healthcheck]\u001b[0m\r\n  \u001b[2mpath = \"/up\"\u001b[0m\r\n  \u001b[2mtimeout = 30\u001b[0m\r\n  \u001b[2minterval = 60\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n\r\n"]
