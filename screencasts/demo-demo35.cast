[0.000, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Summary: Declarative [[addons]] Provisioning                      |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n  \u001b[2mDeclaring an addon in hop3.toml:\u001b[0m\r\n  \u001b[2m  [[addons]]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m  type = \"redis\"\u001b[0m\r\n\r\n"]
[0.000, "o", "  \u001b[2m...makes Hop3 provision the cache, inject REDIS_URL, and wire the\u001b[0m\r\n"]
