[2.354, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m|  Running: Demo 35: Declarative Redis Provider                      |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[2m\r\nDemonstrates declarative addon provisioning via hop3.toml:\r\n  - The app declares its Redis dependency with an [[addons]] section\r\n  - Hop3 provisions the cache and sets REDIS_URL automatically on deploy\r\n  - No manual addon commands — the app is connected as soon as it is deployed\r\n\u001b[0m\r\n\r\n"]
[0.000, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying App with Declarative Redis Provider                     |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[33m->\u001b[0m Application structure:\r\n\r\n  \u001b[36mdemo35/\u001b[0m\r\n  |-- \u001b[32mapp.py\u001b[0m - Flask application with Redis support\r\n"]
[0.000, "o", "  |-- \u001b[32mrequirements.txt\u001b[0m - Python dependencies (flask, redis)\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration with an [[addons]] section\r\n\r\n  \u001b[2mThe app declares a Redis dependency in hop3.toml via [[addons]].\u001b[0m\r\n  \u001b[2mHop3 provisions the cache and injects REDIS_URL automatically\u001b[0m\r\n  \u001b[2mat deploy time — no 'addon create' / 'addon attach' needed.\u001b[0m\r\n\r\n"]
[2.005, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  hop3.toml with an [[addons]] Section                              |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m# hop3.toml - Native Python app with declarative Redis provider\u001b[0m\r\n  \u001b[2m#\u001b[0m\r\n  \u001b[2m# This demo showcases the [[addons]] section for declaring addon dependencies.\u001b[0m\r\n  \u001b[2m# The [[addons]] section declares that this app needs a Redis cache.\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m[metadata]\u001b[0m\r\n  \u001b[2mid = \"demo35-provider-redis\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mversion = \"0.1.0\"\u001b[0m\r\n  \u001b[2mtitle = \"Declarative Redis Demo\"\u001b[0m\r\n  \u001b[2mdescription = \"Demonstrates declarative addon provisioning with [[addons]] section for Redis\"\u001b[0m\r\n  \u001b[2mtags = [\"python\", \"redis\", \"provider\", \"cache\"]\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[build]\u001b[0m\r\n  \u001b[2m# Use native builder - Python toolchain is auto-detected from requirements.txt\u001b[0m\r\n  \u001b[2mbuilder = \"local\"\u001b[0m\r\n  \u001b[2mpip-install = [\"-r\", \"requirements.txt\"]\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m[run]\u001b[0m\r\n  \u001b[2mstart = \"gunicorn --workers 2 --bind 0.0.0.0:$PORT app:app\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m# Declarative addon dependency — this declares that the app needs Redis\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m[[addons]]\u001b[0m\r\n  \u001b[2mtype = \"redis\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\r\n  \u001b[2mNote the [[addons]] section: type = \"redis\".\u001b[0m\r\n"]
[2.002, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Step 1: Deploy (Redis auto-provisioned)                           |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[6.788, "o", "\u001b[33m->\u001b[0m Deploying demo35 application...\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  \u001b[2m$\u001b[0m \u001b[1mhop3 deploy --app demo35 --force\u001b[0m\r\n\r\n"]
