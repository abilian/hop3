[0.006, "o", "\u001b[36m\u001b[1m\r\n    HOP3 DEMOS\r\n    ==========\r\n\r\n    Hop3 Demo Launcher\r\n    \u001b[0m\u001b[0m\r\n\u001b[1mConfiguration:\u001b[0m\r\n  Server:          hop3-dev.abilian.com\r\n  SSH Target:      root@hop3-dev.abilian.com\r\n  Admin User:      admin\r\n  Demos to run:    demo35\r\n"]
