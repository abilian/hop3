[0.000, "o", "\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Running: Demo 31: Native Python + PostgreSQL                      |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[2m\r\nDemonstrates native Python deployment with PostgreSQL addon:\r\n  - Building and deploying a native Python application\r\n  - Creating a PostgreSQL database via addon\r\n  - Connecting the app to PostgreSQL\r\n  - Testing database operations\r\n\u001b[0m\r\n"]
[0.001, "o", "\r\n\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Deploying Native Python + PostgreSQL Application                  |\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n\u001b[33m->\u001b[0m Application structure:\r\n\r\n"]
[0.000, "o", "  \u001b[36mdemo31/\u001b[0m\r\n"]
[0.000, "o", "  |-- \u001b[32mapp.py\u001b[0m - Flask application with PostgreSQL support\r\n"]
[0.000, "o", "  |-- \u001b[32mrequirements.txt\u001b[0m - Python dependencies (flask, psycopg2)\r\n  +-- \u001b[32mhop3.toml\u001b[0m - Hop3 configuration (native Python builder)\r\n\r\n"]
[0.000, "o", "  \u001b[2mThis demo shows a native Python app connecting to a PostgreSQL addon.\u001b[0m\r\n  \u001b[2mUnlike demo15, this does NOT use Docker.\u001b[0m\r\n\r\n"]
[2.006, "o", "\u001b[33m->\u001b[0m hop3.toml:\r\n"]
[0.000, "o", "\r\n"]
[0.001, "o", "  \u001b[2m# hop3.toml - Native Python app with PostgreSQL addon\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n  \u001b[2m[metadata]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mid = \"demo31-postgres\"\u001b[0m\r\n  \u001b[2mversion = \"0.1.0\"\u001b[0m\r\n  \u001b[2mtitle = \"Native PostgreSQL Demo\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mdescription = \"Demonstrates native Python deployment with PostgreSQL addon\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n  \u001b[2m[build]\u001b[0m\r\n  \u001b[2m# Use native builder - Python toolchain is auto-detected from requirements.txt\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mbuilder = \"local\"\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mpip-install = [\"-r\", \"requirements.txt\"]\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2m\u001b[0m\r\n  \u001b[2m[run]\u001b[0m\r\n  \u001b[2mstart = \"gunicorn --workers 2 --bind 0.0.0.0:$PORT app:app\"\u001b[0m\r\n  \u001b[2m\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[2.001, "o", "\r\n\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\u001b[36m\u001b[1m|  Step 1: Deploy Native Python Application                          |\u001b[0m\u001b[0m\r\n"]
[0.000, "o", "\u001b[36m\u001b[1m+====================================================================+\u001b[0m\u001b[0m\r\n\r\n"]
[6.728, "o", "\u001b[33m->\u001b[0m Deploying demo31 application...\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  \u001b[2m$\u001b[0m \u001b[1mhop3 deploy --app demo31 --force\u001b[0m\r\n\r\n"]
